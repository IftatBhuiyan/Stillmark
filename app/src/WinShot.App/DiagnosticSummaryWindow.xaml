<Window x:Class="WinShot.App.DiagnosticSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report an issue — Stillmark"
        Width="620" Height="540"
        MinWidth="500" MinHeight="420"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Stillmark diagnostic summary">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Report an issue"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="Email support@getstillmark.com. Review the details below, then describe the issue in your email draft."
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,16"
                Padding="14,12"
                Background="{DynamicResource QuietAccentSubtleBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE72E;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="16"
                           Foreground="{DynamicResource FocusBrush}"
                           VerticalAlignment="Top"
                           Margin="0,1,11,0" />
                <TextBlock Grid.Column="1"
                           Text="This summary is not sent anywhere. It excludes captures, OCR text, file paths, usernames, machine names, settings, command-line values, license data, and raw logs."
                           TextWrapping="Wrap"
                           FontSize="12"
                           LineHeight="18"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <TextBox x:Name="SummaryText"
                 Grid.Row="2"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="12"
                 Padding="14"
                 Background="{DynamicResource SurfaceBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderSoftBrush}"
                 AutomationProperties.Name="Diagnostic summary for review" />

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,10"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close"
                        MinWidth="88"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        AutomationProperties.Name="Close diagnostic summary"
                        Click="OnClose" />
                <Button x:Name="CopyButton"
                        Content="Copy summary"
                        MinWidth="112"
                        Style="{StaticResource AccentButton}"
                        AutomationProperties.Name="Copy reviewed diagnostic summary"
                        Click="OnCopy" />
                <Button Content="Email report" MinWidth="112" Margin="10,0,0,0"
                        AutomationProperties.Name="Open issue report in your email app"
                        Click="OnEmailReport" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
