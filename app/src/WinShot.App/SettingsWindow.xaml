<UserControl x:Class="WinShot.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinShot.App"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        AutomationProperties.Name="Stillmark Settings">
    <UserControl.Resources>
        <Style x:Key="Tab" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="AccentRail" Width="3" Height="22" HorizontalAlignment="Left"
                                    CornerRadius="0,3,3,0" Background="{DynamicResource TextPrimaryBrush}" Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="AccentRail" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Sw" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="MatrixSw" TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
            <Setter Property="Width" Value="38" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource SettingsRowLabel}" />
        <Style x:Key="MatrixDash" TargetType="TextBlock">
            <Setter Property="Text" Value="–" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- One row of the after-capture matrix -->
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ActionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ShortcutRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,24" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="2,20,0,8" />
        </Style>
        <Style x:Key="SettingsGroup" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style x:Key="SettingsRow" TargetType="Border">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="SwatchRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SwatchBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwatchBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar navigation -->
        <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0" Padding="12,18,12,14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="10,0,10,18">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/WinShot;component/Assets/winshot-master.png" Width="28" Height="28"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Stillmark" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Settings" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Changes save automatically." Margin="10,14,10,0"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel AutomationProperties.Name="Settings categories">
                <ToggleButton x:Name="TabGeneral" Style="{StaticResource Tab}" IsChecked="True" Click="OnTabClick" PreviewKeyDown="OnTabKeyDown" Tag="General"
                              AutomationProperties.Name="General settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="24" VerticalAlignment="Center" />
                        <TextBlock Text="General" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TabWallpaper" Style="{StaticResource Tab}" Click="OnTabClick" PreviewKeyDown="OnTabKeyDown" Tag="Wallpaper"
                              AutomationProperties.Name="Window screenshot settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="24" VerticalAlignment="Center" />
                        <TextBlock Text="Window" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TabShortcuts" Style="{StaticResource Tab}" Click="OnTabClick" PreviewKeyDown="OnTabKeyDown" Tag="Shortcuts"
                              AutomationProperties.Name="Shortcut settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="24" VerticalAlignment="Center" />
                        <TextBlock Text="Shortcuts" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TabRecording" Style="{StaticResource Tab}" Click="OnTabClick" PreviewKeyDown="OnTabKeyDown" Tag="Recording"
                              AutomationProperties.Name="Recording settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="24" VerticalAlignment="Center" />
                        <TextBlock Text="Recording" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TabScreenshots" Style="{StaticResource Tab}" Click="OnTabClick" PreviewKeyDown="OnTabKeyDown" Tag="Screenshots"
                              AutomationProperties.Name="Capture settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="24" VerticalAlignment="Center" />
                        <TextBlock Text="Capture" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TabAbout" Style="{StaticResource Tab}" Click="OnTabClick" PreviewKeyDown="OnTabKeyDown" Tag="About"
                              AutomationProperties.Name="About Stillmark">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="24" VerticalAlignment="Center" />
                        <TextBlock Text="About" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- GENERAL -->
        <ScrollViewer Grid.Column="1" x:Name="PaneGeneral" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,26,30,28"
                      AutomationProperties.Name="General settings">
            <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                <TextBlock Style="{StaticResource PageTitle}" Text="General" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Everyday behavior, storage, and what happens after a capture." />

                <TextBlock Style="{StaticResource SectionLabel}" Text="Appearance &amp; startup" Margin="2,0,0,8" />
                <Border Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsRow}">
                            <CheckBox Style="{StaticResource Sw}" x:Name="ThemeCheck" Click="OnToggle"
                                      AutomationProperties.Name="Use light appearance"
                                      AutomationProperties.HelpText="Switch between the light and dark Stillmark appearance.">
                                <StackPanel>
                                    <TextBlock Text="Use light appearance" FontSize="13" />
                                    <TextBlock Text="Switch between the light and dark palette" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource SettingsRow}">
                            <StackPanel x:Name="StartupSettingGroup">
                                <CheckBox Style="{StaticResource Sw}" x:Name="StartupCheck" Click="OnToggle"
                                          AutomationProperties.Name="Launch at sign-in">
                                    <StackPanel>
                                        <TextBlock Text="Launch at sign-in" FontSize="13" />
                                        <TextBlock Text="Start quietly in the system tray" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock x:Name="StartupStatusText" Visibility="Collapsed"
                                           Margin="0,5,54,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <Border Padding="16,10" MinHeight="58">
                            <CheckBox Style="{StaticResource Sw}" x:Name="PlaySoundCheck" Content="Play a sound after capturing" Click="OnToggle" />
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Capture behavior" />
                <Border Style="{StaticResource SettingsGroup}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsRow}">
                            <CheckBox Style="{StaticResource Sw}" x:Name="HideIconsCheck" Content="Hide desktop icons while capturing" Click="OnToggle" />
                        </Border>
                        <Border Padding="16,10" MinHeight="58">
                            <CheckBox Style="{StaticResource Sw}" x:Name="KeepHistoryCheck" Click="OnToggle"
                                      AutomationProperties.Name="Keep unsaved captures in History"
                                      AutomationProperties.HelpText="Keep up to 40 recent captures locally. Older copies are removed automatically.">
                                <StackPanel>
                                    <TextBlock Text="Keep unsaved captures in History" FontSize="13" />
                                    <TextBlock Text="Keep up to 40 recent captures locally" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Export &amp; delivery" />
                <Border Style="{StaticResource SettingsGroup}" Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="SaveFolderLabel" Text="Export location" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SaveFolderBox" LostFocus="OnSaveFolderChanged"
                                     AutomationProperties.LabeledBy="{Binding ElementName=SaveFolderLabel}"
                                     AutomationProperties.HelpText="Folder where Stillmark saves captures." />
                            <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Padding="12,5" Click="OnBrowseFolder"
                                    AutomationProperties.Name="Browse for export location" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsGroup}" Background="{DynamicResource SurfaceRaisedBrush}">
                                <StackPanel>
                                    <TextBlock Text="Screenshots" FontWeight="SemiBold" Margin="14,12,14,8" />
                                    <Border Style="{StaticResource SettingsRow}"><CheckBox Style="{StaticResource Sw}" x:Name="QuickAccessCheck" Content="Show Quick Access" Click="OnToggle" AutomationProperties.Name="Screenshot: show quick access overlay" /></Border>
                                    <Border Style="{StaticResource SettingsRow}"><CheckBox Style="{StaticResource Sw}" x:Name="ClipboardCheck" Content="Copy to clipboard" Click="OnToggle" AutomationProperties.Name="Screenshot: copy to clipboard" /></Border>
                                    <Border Style="{StaticResource SettingsRow}"><CheckBox Style="{StaticResource Sw}" x:Name="SaveFileCheck" Content="Save to file" Click="OnToggle" AutomationProperties.Name="Screenshot: save to file" /></Border>
                                    <Border Style="{StaticResource SettingsRow}"><CheckBox Style="{StaticResource Sw}" x:Name="EditorAfterCheck" Content="Open editor" Click="OnToggle" AutomationProperties.Name="Screenshot: open annotate editor" /></Border>
                                    <Border Padding="16,10" MinHeight="58"><CheckBox Style="{StaticResource Sw}" x:Name="PinAfterCheck" Content="Pin to screen" Click="OnToggle" AutomationProperties.Name="Screenshot: pin to the screen" /></Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SettingsGroup}" Background="{DynamicResource SurfaceRaisedBrush}">
                                <StackPanel>
                                    <TextBlock Text="Recordings" FontWeight="SemiBold" Margin="14,12,14,8" />
                                    <Border Style="{StaticResource SettingsRow}"><CheckBox Style="{StaticResource Sw}" x:Name="RecQaoCheck" Content="Show Quick Access" Click="OnToggle" AutomationProperties.Name="Recording: show quick access overlay" /></Border>
                                    <Border Style="{StaticResource SettingsRow}"><CheckBox Style="{StaticResource Sw}" x:Name="RecCopyFileCheck" Content="Copy file to clipboard" Click="OnToggle" AutomationProperties.Name="Recording: copy file to clipboard" /></Border>
                                    <Border Style="{StaticResource SettingsRow}"><CheckBox Style="{StaticResource Sw}" x:Name="RecSaveFileCheck" Content="Save to file" Click="OnToggle" AutomationProperties.Name="Recording: save to file" /></Border>
                                    <Border Padding="16,10" MinHeight="58"><CheckBox Style="{StaticResource Sw}" x:Name="RecOpenPlayerCheck" Content="Open video player" Click="OnToggle" AutomationProperties.Name="Recording: open video player" /></Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Notifications" />
                <Border Style="{StaticResource SettingsGroup}" Padding="16,10" MinHeight="58">
                    <CheckBox Style="{StaticResource Sw}" x:Name="NotifyCheck" Content="Show a notification when Quick Access is off" Click="OnToggle" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- WINDOW SCREENSHOTS -->
        <ScrollViewer Grid.Column="1" x:Name="PaneWallpaper" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,26,30,32" Visibility="Collapsed"
                      AutomationProperties.Name="Window and Quick Access presentation settings">
            <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
                <TextBlock Style="{StaticResource PageTitle}" Text="Window" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Frame captures and Quick Access with consistent spacing, shape, and placement." />

                <TextBlock Style="{StaticResource SectionLabel}" Text="Window captures" Margin="2,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource SettingsGroup}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Backdrop" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel x:Name="BgOptionsHost" />
                                <WrapPanel x:Name="ColorSwatches" Margin="0,4,0,0" />
                                <WrapPanel x:Name="GradientSwatches" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="Spacing &amp; effects" />
                        <Border Style="{StaticResource SettingsGroup}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingsRow}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock x:Name="PaddingLabel" Text="Padding" FontSize="13" />
                                            <TextBlock x:Name="PaddingValueText" Text="64 px" FontSize="11" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                        <Slider x:Name="PaddingSlider" Style="{StaticResource SeekSlider}" Minimum="8" Maximum="200" Margin="0,9,0,0"
                                                ValueChanged="OnSliderChanged"
                                                AutomationProperties.LabeledBy="{Binding ElementName=PaddingLabel}"
                                                AutomationProperties.HelpText="Backdrop padding in pixels, from 8 to 200." />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsRow}"><CheckBox Style="{StaticResource Sw}" x:Name="ShadowCheck" Content="Capture window shadow" Click="OnToggle" /></Border>
                                <Border Style="{StaticResource SettingsRow}"><CheckBox Style="{StaticResource Sw}" x:Name="RoundedCheck" Content="Rounded corners" Click="OnToggle" /></Border>
                                <Border Padding="16,10" MinHeight="64">
                                    <CheckBox Style="{StaticResource Sw}" x:Name="ApplyAreaPresentationCheck" Click="OnToggle"
                                              AutomationProperties.Name="Apply padding and backdrop to regular captures"
                                              AutomationProperties.HelpText="Use the selected padding, wallpaper, shadow, and corner treatment for area, display, repeat, timed, and scrolling captures too.">
                                        <StackPanel>
                                            <TextBlock Text="Apply to regular captures" FontSize="13" />
                                            <TextBlock Text="Area, display, repeat, timed, and scrolling capture" FontSize="11" Margin="0,2,16,0"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Grid Margin="2,0,2,8">
                            <TextBlock Text="Live preview" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="" Visibility="Collapsed" HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <Border x:Name="PreviewTile" Height="258" CornerRadius="12"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" ClipToBounds="True"
                                AutomationProperties.Name="Window screenshot preview" />
                        <TextBlock x:Name="PreviewCaption" TextWrapping="Wrap" TextAlignment="Center" Text="Desktop wallpaper · 64 px · Rounded + shadow"
                                   HorizontalAlignment="Center" Margin="0,9,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Quick Access overlay" Margin="2,30,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SettingsGroup}">
                        <StackPanel>
                            <Border Style="{StaticResource SettingsRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PositionLabel" Text="Position on screen" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" x:Name="PositionBox" Width="145" SelectionChanged="OnComboChanged"
                                              AutomationProperties.LabeledBy="{Binding ElementName=PositionLabel}">
                                        <ComboBoxItem Content="Bottom left" />
                                        <ComboBoxItem Content="Bottom right" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRow}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="SizeLabel" Text="Overlay size" />
                                        <TextBlock x:Name="OverlaySizeValueText" Text="100%" HorizontalAlignment="Right" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                    <Slider x:Name="SizeSlider" Style="{StaticResource SeekSlider}" Minimum="0.7" Maximum="1.4" Margin="0,9,0,0"
                                            ValueChanged="OnSliderChanged"
                                            AutomationProperties.LabeledBy="{Binding ElementName=SizeLabel}"
                                            AutomationProperties.HelpText="Quick access overlay scale, from small to large." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AutoHideLabel" Text="Auto-close" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" x:Name="AutoHideBox" Width="145" SelectionChanged="OnComboChanged"
                                              AutomationProperties.LabeledBy="{Binding ElementName=AutoHideLabel}">
                                        <ComboBoxItem Content="When I close it" />
                                        <ComboBoxItem Content="After 5 seconds" />
                                        <ComboBoxItem Content="After 10 seconds" />
                                        <ComboBoxItem Content="After 30 seconds" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Padding="16,10" MinHeight="64">
                                <CheckBox Style="{StaticResource Sw}" x:Name="CloseAfterDragCheck" Click="OnToggle">
                                    <StackPanel>
                                        <TextBlock Text="Close after dragging it out" FontSize="13" />
                                        <TextBlock Text="Dismiss Quick Access after the drag completes" FontSize="11" Margin="0,2,16,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Grid Margin="2,0,2,8">
                            <TextBlock Text="Live preview" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="OverlayPositionValueText" Text="" Visibility="Collapsed" HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <Border x:Name="OverlayPreviewTile" Height="330" CornerRadius="12"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                ClipToBounds="True" AutomationProperties.Name="Quick access overlay preview">
                            <Grid Margin="12">
                                <Border x:Name="OverlayPreviewDesktop" CornerRadius="4"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                    <Grid ClipToBounds="True">
                                        <Border Height="28" VerticalAlignment="Bottom" Background="#D926282D"
                                                BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" />
                                        <ContentControl x:Name="OverlayPreviewCardHost"
                                                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                        HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom"
                                                        Margin="-4,0,-4,24"
                                                        IsTabStop="False" Focusable="False" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="OverlayPreviewCaption" TextWrapping="Wrap" TextAlignment="Center" Text="Bottom left · Default size · After 5 seconds"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,9,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- SHORTCUTS -->
        <ScrollViewer Grid.Column="1" x:Name="PaneShortcuts" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,26,30,28" Visibility="Collapsed"
                      AutomationProperties.Name="Shortcut settings">
            <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                <TextBlock Style="{StaticResource PageTitle}" Text="Shortcuts" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Select a field, then press a new shortcut. Backspace clears it." />

                <TextBlock Style="{StaticResource SectionLabel}" Text="General" Margin="2,0,0,8" />
                <Border Style="{StaticResource SettingsGroup}">
                    <Border Style="{StaticResource ShortcutRow}" BorderThickness="0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="All-In-One" FontSize="13" /><TextBlock Text="Area, window, fullscreen, timer, OCR, and recording" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" /></StackPanel>
                            <local:HotkeyBox Grid.Column="1" x:Name="AllInOneHotkeyBox" TextChanged="OnHotkeyChanged" AutomationProperties.Name="All-In-One shortcut" AutomationProperties.HelpText="Press a new shortcut. Backspace clears it." />
                        </Grid>
                    </Border>
                </Border>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Screenshots" />
                <Border Style="{StaticResource SettingsGroup}"><StackPanel>
                    <Border Style="{StaticResource ShortcutRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Capture area" FontSize="13" VerticalAlignment="Center" /><local:HotkeyBox Grid.Column="1" x:Name="AreaHotkeyBox" TextChanged="OnHotkeyChanged" AutomationProperties.Name="Capture area shortcut" AutomationProperties.HelpText="Press a new shortcut. Backspace clears it." /></Grid></Border>
                    <Border Style="{StaticResource ShortcutRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Capture fullscreen" FontSize="13" VerticalAlignment="Center" /><local:HotkeyBox Grid.Column="1" x:Name="FullscreenHotkeyBox" TextChanged="OnHotkeyChanged" AutomationProperties.Name="Capture fullscreen shortcut" AutomationProperties.HelpText="Press a new shortcut. Backspace clears it." /></Grid></Border>
                    <Border Style="{StaticResource ShortcutRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Capture all monitors" FontSize="13" VerticalAlignment="Center" /><local:HotkeyBox Grid.Column="1" x:Name="AllMonitorsHotkeyBox" TextChanged="OnHotkeyChanged" AutomationProperties.Name="Capture all monitors shortcut" AutomationProperties.HelpText="Press a new shortcut. Backspace clears it." /></Grid></Border>
                    <Border Style="{StaticResource ShortcutRow}" BorderThickness="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Capture previous area" FontSize="13" VerticalAlignment="Center" /><local:HotkeyBox Grid.Column="1" x:Name="RepeatHotkeyBox" TextChanged="OnHotkeyChanged" AutomationProperties.Name="Capture previous area shortcut" AutomationProperties.HelpText="Press a new shortcut. Backspace clears it." /></Grid></Border>
                </StackPanel></Border>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Recording &amp; OCR" />
                <Border Style="{StaticResource SettingsGroup}"><StackPanel>
                    <Border Style="{StaticResource ShortcutRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Record screen / stop" FontSize="13" VerticalAlignment="Center" /><local:HotkeyBox Grid.Column="1" x:Name="RecordHotkeyBox" TextChanged="OnHotkeyChanged" AutomationProperties.Name="Record screen or stop shortcut" AutomationProperties.HelpText="Press a new shortcut. Backspace clears it." /></Grid></Border>
                    <Border Style="{StaticResource ShortcutRow}" BorderThickness="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Capture text (OCR)" FontSize="13" VerticalAlignment="Center" /><local:HotkeyBox Grid.Column="1" x:Name="OcrHotkeyBox" TextChanged="OnHotkeyChanged" AutomationProperties.Name="Capture text shortcut" AutomationProperties.HelpText="Press a new shortcut. Backspace clears it." /></Grid></Border>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>

        <!-- RECORDING -->
        <ScrollViewer Grid.Column="1" x:Name="PaneRecording" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,26,30,28" Visibility="Collapsed"
                      AutomationProperties.Name="Recording settings">
            <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                <TextBlock Style="{StaticResource PageTitle}" Text="Recording" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Choose what appears in recordings and which inputs are included." />

                <TextBlock Style="{StaticResource SectionLabel}" Text="Interface" Margin="2,0,0,8" />
                <Border Style="{StaticResource SettingsGroup}"><StackPanel>
                    <Border Style="{StaticResource SettingsRow}"><CheckBox Style="{StaticResource Sw}" x:Name="ShowControlsCheck" Content="Show controls while recording" Click="OnToggle" /></Border>
                    <Border Style="{StaticResource SettingsRow}"><CheckBox Style="{StaticResource Sw}" x:Name="DisplayTimeCheck" Content="Display recording time" Click="OnToggle" /></Border>
                    <Border Padding="16,10" MinHeight="58"><CheckBox Style="{StaticResource Sw}" x:Name="DimScreenCheck" Content="Dim outside the recording area" Click="OnToggle" /></Border>
                </StackPanel></Border>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Pointer &amp; keyboard" />
                <Border Style="{StaticResource SettingsGroup}"><StackPanel>
                    <Border Style="{StaticResource SettingsRow}"><CheckBox Style="{StaticResource Sw}" x:Name="RecordCursorCheck" Content="Show the cursor" Click="OnToggle" /></Border>
                    <Border Style="{StaticResource SettingsRow}"><CheckBox Style="{StaticResource Sw}" x:Name="HighlightClicksCheck" Content="Highlight clicks" Click="OnToggle" /></Border>
                    <Border Padding="16,10" MinHeight="68"><CheckBox Style="{StaticResource Sw}" x:Name="ShowKeystrokesCheck" Click="OnToggle" AutomationProperties.HelpText="Keystrokes from any application can appear in the recording, including sensitive input."><StackPanel><TextBlock Text="Show keystrokes from all apps" FontSize="13" /><TextBlock Text="May reveal passwords or other sensitive input" FontSize="11" Margin="0,2,16,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel></CheckBox></Border>
                </StackPanel></Border>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Quality &amp; audio" />
                <Border Style="{StaticResource SettingsGroup}"><StackPanel>
                    <Border Style="{StaticResource SettingsRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="FpsLabel" Text="Frame rate" VerticalAlignment="Center" /><ComboBox Grid.Column="1" x:Name="FpsBox" Width="130" SelectionChanged="OnComboChanged" AutomationProperties.LabeledBy="{Binding ElementName=FpsLabel}"><ComboBoxItem Content="30 fps" /><ComboBoxItem Content="60 fps" /></ComboBox></Grid></Border>
                    <Border Style="{StaticResource SettingsRow}"><CheckBox Style="{StaticResource Sw}" x:Name="SystemAudioCheck" Content="Record system audio" Click="OnToggle" /></Border>
                    <Border Padding="16,10" MinHeight="58"><CheckBox Style="{StaticResource Sw}" x:Name="MicrophoneCheck" Content="Record microphone" Click="OnToggle" /></Border>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>

        <!-- CAPTURE / SCREENSHOTS -->
        <ScrollViewer Grid.Column="1" x:Name="PaneScreenshots" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,26,30,28" Visibility="Collapsed"
                      AutomationProperties.Name="Capture settings">
            <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                <TextBlock Style="{StaticResource PageTitle}" Text="Capture" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Control file naming and selection behavior for screenshots." />

                <TextBlock Style="{StaticResource SectionLabel}" Text="Files" Margin="2,0,0,8" />
                <Border Style="{StaticResource SettingsGroup}"><StackPanel>
                    <Border Style="{StaticResource SettingsRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="FormatLabel" Text="File format" /><TextBlock Text="PNG preserves sharp detail; JPG creates smaller files" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel><ComboBox Grid.Column="1" x:Name="FormatBox" Width="130" SelectionChanged="OnComboChanged" AutomationProperties.LabeledBy="{Binding ElementName=FormatLabel}"><ComboBoxItem Content="PNG" /><ComboBoxItem Content="JPG" /></ComboBox></Grid></Border>
                    <Border Padding="16,12"><StackPanel><TextBlock x:Name="TemplateLabel" Text="File name" FontSize="13" /><TextBox x:Name="TemplateBox" Margin="0,8,0,0" TextChanged="OnTemplateChanged" AutomationProperties.LabeledBy="{Binding ElementName=TemplateLabel}" AutomationProperties.HelpText="File name template. Supported tokens are year, month, day, hour, minute, second, and millisecond." /><Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,8,0,0"><TextBlock x:Name="FileNamePreviewText" Text="Stillmark 2026-08-04 at 14.32.08.png" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" /></Border><TextBlock Style="{StaticResource HintText}" Text="Tokens: {yyyy} {MM} {dd} {HH} {mm} {ss} {ms}" Margin="0,5,0,0" /></StackPanel></Border>
                </StackPanel></Border>

                <TextBlock Style="{StaticResource SectionLabel}" Text="Selection" />
                <Border Style="{StaticResource SettingsGroup}"><StackPanel>
                    <Border Style="{StaticResource SettingsRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="TimerLabel" Text="Self-timer" VerticalAlignment="Center" /><ComboBox Grid.Column="1" x:Name="TimerBox" Width="140" SelectionChanged="OnComboChanged" AutomationProperties.LabeledBy="{Binding ElementName=TimerLabel}"><ComboBoxItem Content="3 seconds" /><ComboBoxItem Content="5 seconds" /><ComboBoxItem Content="10 seconds" /></ComboBox></Grid></Border>
                    <Border Style="{StaticResource SettingsRow}"><CheckBox Style="{StaticResource Sw}" x:Name="FreezeScreenCheck" Click="OnToggle" AutomationProperties.Name="Freeze the screen while selecting" AutomationProperties.HelpText="Lets you capture hover states, menus, and animations."><StackPanel><TextBlock Text="Freeze the screen while selecting" FontSize="13" /><TextBlock Text="Capture hover states, menus, and animations" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" /></StackPanel></CheckBox></Border>
                    <Border Padding="16,10" MinHeight="58"><CheckBox Style="{StaticResource Sw}" x:Name="ShowCursorCheck" Content="Show the cursor on screenshots" Click="OnToggle" /></Border>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ABOUT -->
        <ScrollViewer Grid.Column="1" x:Name="PaneAbout" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,26,30,28" Visibility="Collapsed"
                      AutomationProperties.Name="About Stillmark">
            <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                <TextBlock Style="{StaticResource PageTitle}" Text="About" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Your app and updates." />
                <Border Style="{StaticResource SettingsGroup}" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Image Source="/WinShot;component/Assets/winshot-master.png" Width="60" Height="60"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Stillmark" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Source={x:Static local:AppInfo.Version}, StringFormat='Version {0}'}" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="21" Margin="2,16,2,0"
                           Text="Capture, annotate, and share on Windows. Relic stays ready in your system tray, so your next capture is only a shortcut away." />
                <Button Content="About Stillmark" Style="{StaticResource TextCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ManageLicense_Click" />
                <TextBlock Style="{StaticResource SectionLabel}" Text="Updates" />
                <CheckBox x:Name="AutomaticUpdatesCheck" Content="Automatically check for updates" Margin="2,0,2,12"
                          Checked="AutomaticUpdates_Changed" Unchecked="AutomaticUpdates_Changed"
                          ToolTip="Check daily for updates. You choose when to download and restart." />
                <TextBlock x:Name="UpdateStatusText" Text="Public updates will begin with the first signed release."
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,2,12"
                           AutomationProperties.LiveSetting="Polite" />
                <WrapPanel Margin="0,0,0,12">
                    <Button x:Name="UpdateActionButton" Content="Check for updates" IsEnabled="False" Click="UpdateAction_Click" Margin="0,0,10,0" />
                    <Button x:Name="UpdateCancelButton" Content="Cancel" Style="{StaticResource TextCommand}" Visibility="Collapsed" Click="UpdateCancel_Click" />
                </WrapPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Text="Build" />
                <Border Style="{StaticResource SettingsGroup}"><StackPanel>
                    <Border Style="{StaticResource SettingsRow}"><Grid><TextBlock Text="Build" /><TextBlock Text="{x:Static local:AppInfo.BuildDescription}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" /></Grid></Border>
                    <Border Style="{StaticResource SettingsRow}"><Grid><TextBlock Text="Architecture" /><TextBlock Text="x64" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" /></Grid></Border>
                    <Border Padding="16,10" MinHeight="58"><Grid><TextBlock Text="Privacy" /><TextBlock Text="Capture processing stays on this PC" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" /></Grid></Border>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
