<Window x:Class="WinShot.App.VideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stillmark Player"
        Width="960" Height="640"
        MinWidth="560" MinHeight="380"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="12,12,12,8"
                CornerRadius="10"
                Background="#FF0F0F12"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid MouseLeftButtonUp="OnVideoSurfaceClick">
                <MediaElement x:Name="Player"
                              LoadedBehavior="Manual"
                              ScrubbingEnabled="True"
                              Stretch="Uniform"
                              MediaOpened="OnMediaOpened"
                              MediaEnded="OnMediaEnded"
                              MediaFailed="OnMediaFailed" />
                <Border x:Name="BigPlayOverlay"
                        Width="72" Height="72"
                        CornerRadius="36"
                        Background="#B31F1F24"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="BigPlayGlyph"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="26"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="12,0,12,12"
                CornerRadius="10"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                Padding="10,7">
            <DockPanel>
                <Button x:Name="PlayButton" Style="{StaticResource ToolbarButton}" Click="OnPlayPause" ToolTip="Play/Pause (Space)">
                    <TextBlock x:Name="PlayGlyph" FontFamily="{StaticResource IconFont}" FontSize="14" />
                </Button>

                <TextBlock x:Name="TimeText"
                           Text="0:00 / 0:00"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,12,0"
                           MinWidth="86" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button x:Name="SpeedButton" Style="{StaticResource ToolbarButton}" Width="44" Click="OnCycleSpeed" ToolTip="Playback speed">
                        <TextBlock x:Name="SpeedText" Text="1×" FontSize="12" FontWeight="SemiBold" />
                    </Button>
                    <Button x:Name="MuteButton" Style="{StaticResource ToolbarButton}" Click="OnToggleMute" ToolTip="Mute">
                        <TextBlock x:Name="MuteGlyph" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="OnOpenEditor" ToolTip="Trim / convert">
                        <TextBlock x:Name="EditGlyph" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="OnRevealFile" ToolTip="Show in folder">
                        <TextBlock x:Name="FolderGlyph" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>
                </StackPanel>

                <Slider x:Name="SeekBar"
                        Style="{StaticResource SeekSlider}"
                        Minimum="0" Maximum="1"
                        ValueChanged="OnSeekChanged"
                        VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
