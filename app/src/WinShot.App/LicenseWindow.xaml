<UserControl x:Class="WinShot.App.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        AutomationProperties.Name="Stillmark account and activation">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,24,30,28">
            <TextBlock Text="Account &amp; license" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,0" TextWrapping="Wrap"
                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="TrialCountdownText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="StatusDetail" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <StackPanel x:Name="AccountSection" Margin="0,28,0,0" Visibility="Collapsed">
                <StackPanel x:Name="SignInPanel">
                    <TextBlock Text="Sign in with your purchase email" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Your licenses stay with your account. We'll email a sign-in code."
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,16" />
                    <TextBlock x:Name="EmailLabel" Text="Email" FontSize="12" Margin="0,0,0,6" />
                    <TextBox x:Name="EmailBox" MaxLength="320" AutomationProperties.LabeledBy="{Binding ElementName=EmailLabel}" />
                    <Button x:Name="SendCodeButton" Content="Send sign-in code" HorizontalAlignment="Left" Margin="0,12,0,0" Click="SendCode_Click" />
                </StackPanel>
                <StackPanel x:Name="CodePanel" Visibility="Collapsed">
                    <TextBlock x:Name="CodeDescription" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,14" />
                    <TextBlock x:Name="CodeLabel" Text="Email code" FontSize="12" Margin="0,0,0,6" />
                    <TextBox x:Name="CodeBox" MaxLength="8" FontSize="18" FontFamily="Cascadia Mono, Consolas"
                             AutomationProperties.LabeledBy="{Binding ElementName=CodeLabel}" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="VerifyCodeButton" Content="Sign in" Click="VerifyCode_Click" Margin="0,0,10,8" />
                        <Button x:Name="ChangeEmailButton" Content="Change email" Style="{StaticResource TextCommand}" Click="ChangeEmail_Click" Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel x:Name="SignedInPanel" Visibility="Collapsed">
                    <TextBlock x:Name="SignedInEmail" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,14">
                        <Button x:Name="RefreshAccountButton" Content="Refresh licenses" Style="{StaticResource TextCommand}" Click="RefreshAccount_Click" Margin="0,0,10,0" />
                        <Button x:Name="SignOutButton" Content="Sign out" Style="{StaticResource TextCommand}" Click="SignOut_Click" />
                    </WrapPanel>
                    <StackPanel x:Name="AccountLicenses" />
                </StackPanel>
                <TextBlock Text="One active computer per license. Once activated, you can work offline for up to 30 days; Stillmark checks quietly while you’re signed in."
                           TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,0" />
            </StackPanel>

            <Expander x:Name="KeyExpander" Header="Have a license key?" Foreground="{DynamicResource TextSecondaryBrush}"
                      FontSize="12" Margin="0,24,0,0" IsExpanded="True">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock x:Name="KeyLabel" Text="License key" FontSize="12" Margin="0,0,0,6" />
                    <Border x:Name="KeyInputBorder">
                        <TextBox x:Name="KeyBox" MaxLength="8192" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap"
                                 AcceptsReturn="False" MinLines="2" MaxLines="4" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="License key" AutomationProperties.LabeledBy="{Binding ElementName=KeyLabel}"
                                 AutomationProperties.HelpText="Paste the license key issued for this computer." />
                    </Border>
                    <Button x:Name="ActivateButton" Content="Activate key" HorizontalAlignment="Left" Margin="0,12,0,0"
                            AutomationProperties.Name="Activate license" Click="Activate_Click" />
                </StackPanel>
            </Expander>
            <TextBlock x:Name="MessageText" Margin="0,16,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite" />
            <WrapPanel Margin="0,24,0,0">
                <Button x:Name="BuyButton" Content="Buy a license" Margin="0,0,8,8" Visibility="Collapsed" IsEnabled="False" Click="Buy_Click" />
                <Button x:Name="AccountButton" Content="Manage license" Margin="0,0,8,8" Visibility="Collapsed" IsEnabled="False" Click="Account_Click" />
                <Button x:Name="DeactivateButton" Content="Deactivate this computer" Style="{StaticResource TextCommand}" Margin="0,0,8,8" Visibility="Collapsed" Click="Deactivate_Click" />
                <Button x:Name="ContinueButton" Content="Continue trial" Margin="0,0,0,8" Visibility="Collapsed" Click="Continue_Click" />
            </WrapPanel>
            <TextBlock x:Name="ActivationHelpText" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
