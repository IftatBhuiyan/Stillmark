<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pin package sources to nuget.org only, independent of user/machine config, so a rogue
       source can't shadow a dependency. packageSourceMapping constrains every package to nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
